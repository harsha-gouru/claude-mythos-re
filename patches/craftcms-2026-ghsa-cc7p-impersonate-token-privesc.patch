-                if ($result['usageCount'] < $result['usageLimit'] - 1) {
+                $newUsageCount = $result['usageCount'] + 1;
+                if ($newUsageCount < $result['usageLimit']) {
                     // Increment its count
                     $this->incrementTokenUsageCountById($result['id']);
