                 } else {
                     // Just delete it
                     $this->deleteTokenById($result['id']);
-
-                    // Remove it from the request as well so it doesn’t get added to generated URLs
-                    Craft::$app->getRequest()->setToken(null);
+                    $this->_remainingTokenUsages[$token] = 0;
                 }
